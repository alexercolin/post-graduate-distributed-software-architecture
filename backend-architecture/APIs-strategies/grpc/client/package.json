{
  "name": "grpc-task-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "proto:generate": "grpc_tools_node_protoc --ts_proto_out=./src/generated --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=esModuleInterop=true --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --proto_path=../proto ../proto/tasks.proto",
    "dev": "tsx src/client.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@grpc/grpc-js": "^1.10.9"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "grpc-tools": "^1.13.1",
    "ts-proto": "^2.11.8",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
